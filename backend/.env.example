MONGODB_URI=mongodb://127.0.0.1:27017/jobjoint
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-another-random-secret-at-least-32
FRONTEND_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Optional: demo account seed password. Keep private; never use the demo default in production.
DEMO_PASSWORD=replace-with-a-private-demo-password
# Google Identity Services web OAuth client ID (same public ID as frontend/.env). No client secret is used.

GOOGLE_CLIENT_ID=
